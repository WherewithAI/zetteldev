# === SolveIt from the terminal ===
# The dialog is remembered in the nearest `.solveit-dialog` (write it with `just sicx use <dialog>`), the URL
# defaults to the tunnel at localhost:5001, and every command runs from the directory you invoke it in.

# The plain client with the dialog filled in:  just sic message.exec --id <id>
[no-cd]
sic *args:
    SOLVEIT_DIALOG="${SOLVEIT_DIALOG:-$(cat .solveit-dialog 2>/dev/null || cat ../.solveit-dialog 2>/dev/null)}" sic {{args}}

# Queue-safe run/add/edit/bootstrap/out/slim/status/stop/open:  just sicx run <id>
[no-cd]
sicx *args:
    @bash {{justfile_directory()}}/.zetteldev/solveit-master
    uv run --quiet --with solveit-client python {{justfile_directory()}}/.zetteldev/sicx.py {{args}}

# One multiplexed ssh connection to the instance, and the laptop:5001 forward every client rides, re-armed when down:  just solveit-master [--status]
solveit-master *args:
    bash .zetteldev/solveit-master {{args}}
# === Local Dask Cluster (Athomia) ===
# A discoverable, self-healing Dask cluster on this box (Athomia). See zetteldev.cluster (renamed from zetteldev.dask on 2026-09-22: the old name shadowed the dask package).
# Default launch is PRIVATE (loopback); reach it from elsewhere over an SSH tunnel
# (zdask.connect("athomia")). Exposing the raw, unauthenticated port on the tailnet
# is the separate, deliberate `dask-athomia-exposed`.

# Usage (args pass through to `zetteldev.cluster up`):
#   just dask-athomia                          # gpus=all, 2 workers (both 4090s visible)
#   just dask-athomia --gpus pin               # one worker per card, GPU-resource tagged
#   just dask-athomia --gpus none --workers 8  # CPU-only flood cluster

# Launch/discover the Athomia cluster, bound privately to loopback (reach remotely via zdask.connect)
dask-athomia *args:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run python -m zetteldev.cluster up {{args}}
    echo 'Private (loopback). From another machine: zdask.connect("athomia")'

# Launch bound to the Tailscale IP — reachable by any tailnet device WITHOUT SSH auth (prefer dask-athomia)
dask-athomia-exposed *args:
    #!/usr/bin/env bash
    set -euo pipefail
    host=$(tailscale ip -4 2>/dev/null | head -1) || { echo "tailscale not up" >&2; exit 1; }
    echo "⚠ Binding scheduler to $host (Tailscale) — UNAUTHENTICATED, trusts your whole tailnet"
    uv run python -m zetteldev.cluster up --host "$host" {{args}}

# Status of the Athomia Dask cluster (liveness, workers, dashboard)
dask-status:
    uv run python -c "from zetteldev import dask as z; import json; print(json.dumps(z.status(), indent=2))"

# Tear down the Athomia Dask cluster
dask-down:
    uv run python -c "from zetteldev import dask as z; z.shutdown(); print('cluster down')"

# === SolveIt git cycle (this machine is the source of truth; see .zetteldev/solveit_sync.sh) ===

# Ahead/behind counts against SolveIt and origin, dirty paths on both sides, last sync
solveit-status:
    bash .zetteldev/solveit_sync.sh status

# Commit SolveIt's dialog state, merge its branch here, push origin, fast-forward SolveIt (hourly via cron)
solveit-sync:
    bash .zetteldev/solveit_sync.sh sync

# Export a dialog's #|export cells to the project module here, then commit the modules:  just solveit-export experiments/35-rl-forecasting/6-ee-trained-search-agent-tinker.ipynb
solveit-export nb:
    # secondary modules (`#|export other_mod`) are appended to, never rewritten, so seed each one afresh before exporting
    for m in $(grep -oh "#|export [a-z_]*" {{nb}} | awk '{print $2}' | sort -u); do printf '__all__ = []\n' > $(python3 -c "import tomllib; print(tomllib.load(open('pyproject.toml', 'rb'))['project']['name'])")/$m.py; done
    uv run python -c "from nbdev.export import nb_export; nb_export('{{nb}}', '$(python3 -c "import tomllib; print(tomllib.load(open('pyproject.toml', 'rb'))['project']['name'])")')"
    uv run python .zetteldev/nbsnake.py {{nb}}
    git add $(python3 -c "import tomllib; print(tomllib.load(open('pyproject.toml', 'rb'))['project']['name'])")/*.py; [ -d $(dirname {{nb}})/rules ] && git add $(dirname {{nb}})/rules; git commit -q -m "export {{nb}}" && git log --oneline -1

