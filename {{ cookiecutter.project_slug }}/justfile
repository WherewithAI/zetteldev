# README.md from experiments/index.ipynb alone. `nbdev-readme` first preprocesses EVERY file under nbs_path (the whole experiments
# tree, processed_data and playpen included: ten minutes of copying) and dies on any notebook whose cells fail the filter pass
# (2026-09-21: exp18's `from paper2solveit import *`). This renders the one notebook that matters, in a scratch directory.
readme:
    #!/usr/bin/env bash
    set -euo pipefail
    d=$(mktemp -d); cp experiments/index.ipynb "$d/"; (cd "$d" && quarto render index.ipynb -o README.md -t gfm --no-execute --quiet)
    cp "$d/README.md" README.md; rm -rf "$d"; echo "README.md rendered from experiments/index.ipynb ($(wc -l < README.md) lines)"

# Render notebooks to zettels (markdown)
zettelmaker:
    uv run quarto render nbs/experiments --to gfm --no-execute --output-dir ../zettels --profile zettels

