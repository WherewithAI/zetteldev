# === Paper Sync (Obsidian ↔ Overleaf) ===
# Canonical source is a single Workshop md file configured in papers/<slug>/paper.yaml.
# Outbound (push-paper): md → tex + R2 figures → Overleaf. Inbound (pull-paper):
# draft md patches from Overleaf edits into papers/<slug>/review/ for human acceptance.

# Convert a PDF/arXiv URL to markdown in the current directory via Datalab Marker.
mdify-paper url:
    python3 .zetteldev/mdify_paper.py "{{url}}" --output-dir "{{invocation_directory()}}"

# Scaffold a new paper dir and clone its Overleaf git repo (interactive)
new-paper slug:
    python3 .zetteldev/paper/sync.py new {{slug}}

# Import a template zip (url or local path) into .zetteldev/paper/templates/<name>/
import-paper-template name source:
    python3 .zetteldev/paper/sync.py import-template {{name}} {{source}}

# Copy a template's files into papers/<slug>/overleaf/ (non-destructive).
# Slug omittable when only one paper exists: `just apply-paper-template <template>`.
apply-paper-template *args:
    python3 .zetteldev/paper/sync.py apply-template {{args}}

# Render md → tex, fetch R2 figures, commit + push to Overleaf.
# Slug omittable when only one paper exists.
push-paper *args:
    python3 .zetteldev/paper/sync.py push {{args}}

# Preview outbound changes without committing
paper-diff *args:
    python3 .zetteldev/paper/sync.py diff {{args}}

# Refresh only overleaf/figures/ from R2 (no tex regeneration)
update-paper-figures *args:
    python3 .zetteldev/paper/sync.py figures {{args}}

# Pull Overleaf; LLM drafts md review patches into papers/<slug>/review/
pull-paper *args:
    python3 .zetteldev/paper/sync.py pull {{args}}

# List drafted review patches awaiting acceptance
paper-pending *args:
    python3 .zetteldev/paper/sync.py pending {{args}}

# Apply a drafted review patch to the source md.
# Slug omittable when only one paper exists: `just paper-accept <patch_id>`.
paper-accept *args:
    python3 .zetteldev/paper/sync.py accept {{args}}

