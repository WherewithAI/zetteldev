# === Submission Pre-flight ===

# Lint sbatch scripts against the invariants we bought with GPU-hours
# (lonely embedder, oversubscribed card, thin keep-alive, long walltime, ...).
# No args lints every tracked *.sbatch; exit 1 if any ERROR is found.
#   just preflight
#   just preflight experiments/42-stuckness-modeling/scripts/slurm/counsel.sbatch
preflight *args:
    .zetteldev/della/bin/sbatch-lint {{args}}

# Submit one sbatch on Della through the gate (clean pushed tree, lint, `# preflight:` lines, sanitised env), from here:
#   just della-sbatch experiments/35-rl-forecasting/scripts/slurm/train_selector.sbatch --time 01:00:00 --env STEPS=1 --env BATCH=2
# Test jobs: --time 01:00:00 (schedules sooner than the six hours the scripts declare for real runs).
# Since 2026-09-22 this is the one-job form of della-sbatch-bg (below): it pushes once with a timeout, hands the submission to
# Della, and returns in seconds; the job id lands in .zetteldev/della/batches/<label>.log (`just della-batch-log <label>`), where
# the label is the script's basename and the minute of submission. Nothing in the foreground past a minute.
della-sbatch script *args:
    #!/usr/bin/env bash
    just della-sbatch-bg-one "$(basename "{{script}}" .sbatch)-$(date +%m%d%H%M)" "{{script}}" {{args}}

# The same gate, in the background, for one job or many (the author's standing policy, 2026-09-22: nothing in the foreground
# past a minute). One push with a timeout, then the batch file goes to Della where della-submit-batch queues each line serially
# and appends `<label>|<job id>|ok` (or `|-|FAILED <reason>`) to the log as it lands, ending with `BATCH_DONE queued/total`.
# Returns at once with the log path; tail the log (a Monitor) for the ids.
#   just della-sbatch-bg <batch file>          batch lines: <label>|<della-submit args, script path included>
#   just della-sbatch-bg-one <label> <script> [args...]   the one-job form, written to a batch of one
# Logs live under .zetteldev/della/batches/<batch name>.log (gitignored); the pull's stderr and each label's gate stderr beside it.
della-sbatch-bg batch:
    #!/usr/bin/env bash
    set -uo pipefail
    name="$(basename "{{batch}}" .txt)"; log=".zetteldev/della/batches/$name.log"; mkdir -p .zetteldev/della/batches
    timeout 60 git push -q origin "$(git branch --show-current)" || { echo "della-sbatch-bg: push failed or timed out; nothing submitted" >&2; exit 1; }
    scp -q "{{batch}}" della:/tmp/della_batch_$name.txt
    ssh -o ConnectTimeout=20 "$(python3 .zetteldev/config.py della_host)" "cd $(python3 .zetteldev/config.py della_repo) && git pull -q --ff-only origin $(git branch --show-current) && mkdir -p .zetteldev/della/batches && (nohup .zetteldev/della/bin/della-submit-batch /tmp/della_batch_$name.txt $log >$log.nohup 2>&1 &)" </dev/null || { echo "della-sbatch-bg: could not start the batch on Della (pull or launch failed)" >&2; exit 1; }
    echo "della-sbatch-bg: batch $name submitting on Della; ids land in della:$(python3 .zetteldev/config.py della_repo)/$log (tail it with just della-batch-log $name)"

# Read a batch's log from Della (one call, no wait): the ids so far and BATCH_DONE when all are through.
della-batch-log name:
    ssh -o ConnectTimeout=20 "$(python3 .zetteldev/config.py della_host)" "cat $(python3 .zetteldev/config.py della_repo)/.zetteldev/della/batches/{{name}}.log 2>/dev/null || echo '(no log yet)'" </dev/null

# One multiplexed ssh connection to Della for every caller (2026-09-23: the gateway blocked Athomia's address after hours of
# 30-second polls whose control master had died, each poll a fresh handshake). Every Della wrapper calls this first.
della-master *args:
    bash .zetteldev/della/bin/della-master {{args}}

# The one poller: `just della-status run` in a tmux window writes ~/.cache/della/status.json every five minutes (queue plus every
# registered snippet); Monitors and driver wakes read the file and never open ssh themselves.
#   just della-status add exp33_canon 'cd $(python3 .zetteldev/config.py della_repo)/experiments/33-*/processed_data/crosspolicy/canon && for d in *; do echo "$(ls $d | wc -l) $d"; done'
#   just della-status show [NAME]        just della-status once
[positional-arguments]
della-status *args:
    python3 .zetteldev/della/bin/della-status "$@"

della-sbatch-bg-one label script *args:
    #!/usr/bin/env bash
    mkdir -p .zetteldev/della/batches; b=".zetteldev/della/batches/{{label}}.txt"; echo "{{label}}|{{args}} {{script}}" > "$b"; just della-sbatch-bg "$b"

